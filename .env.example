# Copia este archivo como .env y completa los valores. Nunca subas .env a git.

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=cambia_esto
PGDATABASE=queseria

# Backend (API)
# Secreto para firmar los JWT y los códigos de activación (mínimo 16 caracteres, aleatorio).
# Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Orígenes permitidos para el panel web (separados por coma)
CORS_ORIGENES=http://localhost:5173
# Opcionales (valores por defecto):
# JWT_MINUTOS_ADMIN=30
# JWT_MINUTOS_MOVIL=720
# CODIGO_ACTIVACION_MINUTOS=60   (código de activación: un solo uso)
# PIN_MAX_INTENTOS=5
# PIN_BLOQUEO_MIN=15
# Fotos de análisis de calidad (carpeta fuera de git y tamaño máximo por foto)
# STORAGE_DIR=D:\ruta\absoluta\storage   (por defecto: backend\storage)
# FOTO_MAX_MB=5
