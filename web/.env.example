# Panel web: copia este archivo como web\.env.local (ignorado por git).
# Todo lo VITE_* termina dentro del JavaScript que recibe el navegador: aquí NUNCA va un secreto.

# Dirección de la API (backend\scripts\dev.ps1 escucha en 127.0.0.1:8000).
# El origen del panel (http://localhost:5173) debe estar en CORS_ORIGENES del .env de la raíz.
VITE_API_URL=http://127.0.0.1:8000
